# Environment Variables - Bar El Portalón
# 
# Copy this file to .env.local and fill in the values
# IMPORTANT: Never commit .env.local to Git (add to .gitignore)

# ===== SUPABASE CONFIGURATION =====
# These are required for authentication and data access
# Get these values from your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Navigate to Settings → API
# 4. Copy the values below

# The public URL of your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The anonymous public key (safe to expose in frontend code)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== OPTIONAL: FUTURE INTEGRATIONS =====
# Add variables here as needed for future services

# Example for Google Maps API (if needed):
# VITE_GOOGLE_MAPS_KEY=your-api-key-here

# Example for email service:
# VITE_EMAIL_SERVICE_KEY=your-service-key-here

# ===== NOTES =====
# - All variables prefixed with VITE_ are exposed to the frontend (frontend-safe)
# - Never commit secrets or keys to Git
# - Each environment (dev, staging, production) should have its own .env file
# - For Vercel deployment, set environment variables in the Vercel dashboard
