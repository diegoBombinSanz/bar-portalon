{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/404$",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "^/404/$",
      "status": 308,
      "headers": {
        "Location": "/404"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api(?:/|$))(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/barra$",
      "dest": "/index.html"
    },
    {
      "src": "^/galeria$",
      "dest": "/index.html"
    },
    {
      "src": "^/entrevinos$",
      "dest": "/index.html"
    },
    {
      "src": "^/antiguos-eventos$",
      "dest": "/index.html"
    },
    {
      "src": "^/aviso$",
      "dest": "/index.html"
    },
    {
      "src": "^/politica$",
      "dest": "/index.html"
    },
    {
      "src": "^/login$",
      "dest": "/index.html"
    },
    {
      "src": "^/admin$",
      "dest": "/index.html"
    },
    {
      "src": "^/admin/config$",
      "dest": "/index.html"
    },
    {
      "src": "^/400$",
      "dest": "/index.html"
    },
    {
      "src": "^/500$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "crons": []
}
